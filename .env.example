# Proveedor LLM compatible con la API de OpenAI (Groq gratis; también sirve xAI: https://api.x.ai/v1)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Lista separada por comas: si un modelo se queda sin cupo (429) se usa el siguiente
LLM_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Modelos para el termómetro y los resúmenes (opcional, por defecto LLM_MODEL)
LLM_ANALYZER_MODEL=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Esfuerzo de razonamiento para modelos gpt-oss (low recomendado: menos tokens y latencia)
LLM_REASONING_EFFORT=low

# Transcripción de notas de voz (API compatible con OpenAI /audio/transcriptions, p. ej. Groq Whisper)
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# Minutos sin respuesta del operador tras los cuales la IA retoma la conversación (0 = nunca)
HANDOVER_TIMEOUT_MIN=15

# Telegram: token entregado por @BotFather
TELEGRAM_BOT_TOKEN=

# WhatsApp (whatsapp-web.js): true para habilitar el canal
WHATSAPP_ENABLED=false

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Base de datos SQLite y caché de cursos
DB_PATH=data/agente.db
COURSES_REFRESH_HOURS=6

# Número de WhatsApp que muestra la landing pública /contacto.html (opcional; por defecto, el número conectado)
PUBLIC_WHATSAPP_NUMBER=

# Ruta al ejecutable de Chrome/Chromium para whatsapp-web.js
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
