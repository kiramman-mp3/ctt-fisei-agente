{
  "name": "ctt-fisei-agente",
  "version": "1.0.0",
  "description": "Agente de atención con IA para los cursos del CTT-FISEI (Telegram + WhatsApp) con dashboard de interacciones",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "scrape": "node src/scraper/run.js",
    "models": "node src/agent/list-models.js",
    "seed": "node src/db/seed.js",
    "operator": "node scripts/set-operator.js",
    "eval": "node scripts/eval-agent.js",
    "demo:check": "node scripts/demo-check.js",
    "lint": "eslint .",
    "test": "node --test",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "check": "npm run lint && npm test",
    "deploy:azure": "bash scripts/deploy-azure.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "openai": "^7.45.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "undici": "^8.12.3",
    "whatsapp-web.js": "^1.34.7"
  }
}
